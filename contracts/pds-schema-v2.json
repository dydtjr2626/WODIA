{
  "version": 2,
  "database": "SQLite (data/pds.db, 서버 파일 DB — 브라우저 저장소 아님)",
  "date_rules": {
    "timezone": "Asia/Seoul (+09:00) — 저장·표시·지연 판정 모두 동일",
    "date": "YYYY-MM-DD 문자열",
    "time": "HH:MM (계획 시각)",
    "datetime": "ISO 8601, 항상 +09:00 오프셋 (예: 2026-11-16T06:50:00+09:00)",
    "duration_unit": "분(integer) — 저장과 표시 모두 분, 화면에서만 '시간 분'으로 풀어 보여줌",
    "week": "월요일 시작, 일요일 끝. 못 한 운동은 같은 주 안에서만 밀리고 다음 주로 넘어가지 않음",
    "overdue": "status = todo 이고 due_date < 오늘(서울). 완료·건너뜀은 지연으로 세지 않음"
  },
  "tables": {
    "plans": {
      "purpose": "계획의 현재 값",
      "columns": {
        "id": "TEXT PK, PLN-001 형식, 수정해도 유지",
        "title": "TEXT",
        "category": "TEXT",
        "start_date": "TEXT date",
        "end_date": "TEXT date",
        "priority": "INTEGER 1=높음 2=보통 3=낮음",
        "success_criteria": "TEXT",
        "est_min": "INTEGER 분 (주당 예상 시간)",
        "improvement": "TEXT 회고에서 정한 개선점 (다음 계획 반영분)",
        "rev_no": "INTEGER 현재 버전",
        "created_at": "TEXT datetime",
        "updated_at": "TEXT datetime"
      }
    },
    "plan_revisions": {
      "purpose": "계획 수정 이력. rev_no 0 = 최초 계획. 트리거로 UPDATE/DELETE 차단(추가만 가능)",
      "columns": {
        "id": "INTEGER PK",
        "plan_id": "FK plans.id",
        "rev_no": "INTEGER",
        "title/category/start_date/end_date/priority/success_criteria/est_min/improvement": "그 시점 값",
        "change_note": "TEXT",
        "created_at": "TEXT datetime"
      },
      "unique": [
        "plan_id",
        "rev_no"
      ]
    },
    "tasks": {
      "purpose": "할 일. 모든 할 일은 하나의 계획에 속함",
      "columns": {
        "id": "INTEGER PK",
        "plan_id": "FK plans.id",
        "title": "TEXT",
        "detail": "TEXT 메모(운동 부위·공부량 등)",
        "tags": "TEXT 쉼표 구분",
        "due_date": "TEXT date",
        "due_time": "TEXT HH:MM 또는 빈 문자열",
        "priority": "INTEGER 1~3",
        "est_min": "INTEGER 분",
        "status": "todo | done | skipped",
        "completed_at": "TEXT datetime",
        "original_date": "TEXT date 최초 배정일 (운동이 밀렸을 때 확인용)",
        "gen_key": "TEXT UNIQUE 자동 생성 중복 방지"
      }
    },
    "runs": {
      "purpose": "실행 기록. 계획(tasks)을 덮어쓰지 않고 별도로 쌓임",
      "columns": {
        "id": "INTEGER PK",
        "task_id": "FK tasks.id (ON DELETE CASCADE)",
        "status": "done | skipped | voided(완료 취소됨)",
        "planned_date": "TEXT date",
        "started_at": "TEXT datetime",
        "ended_at": "TEXT datetime",
        "actual_min": "INTEGER 분",
        "block_reason": "TEXT 막힘/건너뜀 사유",
        "condition_score": "INTEGER 1~5 컨디션(선택)",
        "idempotency_key": "TEXT UNIQUE — 같은 요청은 한 번만 저장",
        "created_at": "TEXT datetime"
      },
      "constraints": [
        "UNIQUE INDEX one_done_run_per_task (task_id) WHERE status='done' → 완료 기록은 할 일당 1건"
      ]
    },
    "workout_sets": {
      "purpose": "운동 할 일의 세트 기록",
      "columns": {
        "id": "INTEGER PK",
        "task_id": "FK tasks.id (ON DELETE CASCADE)",
        "exercise": "TEXT",
        "set_no": "INTEGER 운동별 번호",
        "weight_kg": "REAL",
        "reps": "INTEGER",
        "created_at": "TEXT datetime"
      }
    },
    "retro_notes": {
      "purpose": "주간 회고에서 정한 개선점 1건과 그것이 반영된 계획 버전",
      "columns": {
        "week_start": "TEXT date PK",
        "plan_id": "FK plans.id",
        "improvement": "TEXT",
        "plan_rev_no": "INTEGER 반영된 plans 버전",
        "saved_at": "TEXT datetime"
      }
    }
  },
  "relations": [
    "plans 1 — N plan_revisions",
    "plans 1 — N tasks",
    "tasks 1 — N runs",
    "plans 1 — N retro_notes (주당 1건)"
  ],
  "review_formulas": {
    "계획 수": "해당 주(월~일) due_date 의 할 일 수 (삭제된 할 일 제외 — 삭제는 실제 행 삭제)",
    "완료 수": "그 중 status = done",
    "지연 수": "status = todo 이고 due_date < 오늘(서울)",
    "막힘 수": "voided 가 아닌 실행 기록에 block_reason 이 하나 이상 있는 할 일 수",
    "예상 시간": "대상 할 일 est_min 합",
    "실제 시간": "대상 할 일의 done 실행 기록 actual_min 합",
    "차이": "실제 − 예상 (대상이 없으면 0)"
  }
}